# ==============================================================
# GASTRO-SIM · Variables del frontend
# Responsable: Cristian Cruz (Designer / Support Manager)
# Copia este archivo como ".env" dentro de la carpeta frontend/.
# Todo lo que empieza por VITE_ llega al navegador: aquí NUNCA va
# la clave service_role ni la contraseña de la base de datos.
# ==============================================================

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API Keys → clave "anon" o "publishable" (es pública).
VITE_SUPABASE_ANON_KEY=

# Dirección de la API (FastAPI con Docker).
VITE_API_URL=http://localhost:8000
