# ==============================================================
# GASTRO-SIM · Variables de entorno de ejemplo
# Responsable: Nestor Velasco (actividad 4612 · RNF-10)
# Copia este archivo como ".env" y cambia los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# ==============================================================

# --- Base de datos local (solo desarrollo con Docker) ---
POSTGRES_USER=gastro
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=gastro_sim

# Cadena de conexión que usa la API.
# Con Docker, el servidor se llama "db" (nombre del servicio en docker-compose.yml).
# Sin Docker, usa localhost y el puerto de tu PostgreSQL.
DATABASE_URL=postgresql://gastro:cambia-esta-clave@db:5432/gastro_sim

# --- API ---
ENTORNO=desarrollo
APP_VERSION=0.1.0
# Dominios del frontend que pueden llamar a la API, separados por coma.
CORS_ORIGENES=http://localhost:5173
